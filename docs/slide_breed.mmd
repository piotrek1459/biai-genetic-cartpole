flowchart TD
    N["_breed(parents, boost)"] --> N1["for i = 0, 2, 4 ... n:"]
    N1 --> N2["p1 = parents[i]\np2 = parents[(i+1) % n]"]
    N2 --> N3["c1, c2 = crossover_fn(p1, p2)"]
    N3 --> CX1["OX: copy segment from p1\nfill gaps from p2 in order\n→ valid permutation"]
    N3 --> CX2["PMX: copy segment\nresolve conflicts via\nposition mapping"]
    N3 --> CX3["Uniform: each gene from\nrandom parent (prob=0.5)"]
    N3 --> CX4["Arithmetic:\nc = alpha*p1 + (1-alpha)*p2"]
    CX1 & CX2 & CX3 & CX4 --> MU["c1 = mutation_fn(c1)\nc2 = mutation_fn(c2)"]
    MU --> B2{boost?}
    B2 -- Yes --> MB["c1 = mutation_fn(c1) again\nc2 = mutation_fn(c2) again\n2x perturbation breaks stagnation"]
    B2 -- No --> APP["offspring.append(c1, c2)"]
    MB --> APP
